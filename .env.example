# Main providers — add any one of these (or paste them in Settings)
# GROQ_API_KEY=gsk-...            # fast Llama / gpt-oss via Groq
# NVIDIA_API_KEY=nvapi-...        # Llama, Mistral, DeepSeek, Qwen, Nemotron via NIM
# GEMINI_API_KEY=AIza-...         # Antigravity / Gemini models (or ANTIGRAVITY_API_KEY)
# ANTIGRAVITY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: OpenAI (computer-use + voice) and OpenRouter (open models)
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...  # open models (Kimi, DeepSeek, Qwen, GLM...) through OpenRouter

# Optional overrides
# DOTS_MODEL=gpt-5.5            # default: best available on your key
# DOTS_REVIEW_MODEL=gpt-5.4-mini
# DOTS_VOICE_MODEL=gpt-realtime-2.1
# "computer" = OpenAI computer-use tool driving the dot's browser; "off" = DOM browser tools only
DOTS_COMPUTER_TOOL=computer

# Computers: a cloud computer per dot with E2B, otherwise a Docker container, otherwise a sandbox folder
# E2B_API_KEY=e2b_...
# DOTS_COMPUTER=cloud           # force cloud | docker | local
DOTS_BOX_IMAGE=node:22-bookworm

# Triggers: the API key of a Composio project (platform.composio.dev)
# COMPOSIO_API_KEY=ak_...

# Where the app is served (Composio sign-in redirects back here)
# DOTS_PUBLIC_URL=http://localhost:3100

# Where chats, vault, browser profiles and workspaces are kept (default: .data/ in the project)
# DOTS_DATA_DIR=.data

# Desktop dev only (electron/ + pnpm desktop:dev)
# SOLI_DEV_URL=http://localhost:3100
# SOLI_PORT=3100

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET=
# SESSION_MAX_AGE_SECONDS=604800
# ADMIN_EMAILS=partner@firm.com,office-manager@firm.com
# Admins reach the console at /admin (corpus, users, models, limits).
# Signup gate for demos/pilots (invite codes win over domains; unset = open registration)
# SIGNUP_INVITE_CODES=firm-2026-xxxx,firm-2026-yyyy
# SIGNUP_ALLOWED_DOMAINS=firm.com,client.com

# --- Demo seed ---
# Set to "1" to enable demo seed on first boot (creates a demo dot + sample conversation)
# DEMO_SEED=1

# --- Legal RAG engine ---
# PostgreSQL metadata store for legal documents/chunks
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/soli

# Qdrant vector store for legal chunks
# QDRANT_URL=https://xxxxx-xxxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=soli_chunks

# NVIDIA NIM models used by the legal RAG engine
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_LLM_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# NIM_EMBEDDING_MODEL=nvidia/nvidia-embed-qa-4
# EMBEDDING_DIMENSIONS=1024

# Legal ingestion/retrieval tuning
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# TOP_K=5
# RAG_MIN_SCORE=0.3
# RAG_CONTEXT_MAX_CHARS=12000
# RAG_CHUNK_MAX_CHARS=4000
# RAG_TEMPERATURE=0.2
